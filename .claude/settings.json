
{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm --prefix apps/web *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma validate *)",
      "Bash(node --test *)",
      "Bash(ventra-git *)",
      "Bash(ventra-approval *)",
      "Bash(ventra-handoff *)",
      "Bash(ventra-verify *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh pr create --draft *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status)",
      "Bash(supabase start *)",
      "Bash(supabase stop *)",
      "Bash(supabase status *)",
      "Bash(supabase migration new *)",
      "Bash(vercel deploy)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker compose ps *)",
      "Bash(lsof *)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(supabase db reset)",
      "Bash(supabase db push *)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy --prod *)",
      "Bash(npm publish *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(stripe *)",
      "Bash(paypal *)",
      "WebFetch(domain:api.stripe.com)",
      "WebFetch(domain:api.paypal.com)",
      "WebFetch(domain:checkout.stripe.com)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(printenv *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.openclaw/**)",
      "Edit(~/.openclaw/**)",
      "Edit(/.claude/settings*.json)",
      "Edit(~/.claude/settings*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.local/share/ventra-agents/guard-edit.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.local/share/ventra-agents/guard-bash.mjs\""
          }
        ]
      }
    ]
  }
}
