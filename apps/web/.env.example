# Placeholder values only, for a separately approved DEV / isolated local project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local-only convenience: redirect /workspace to the synthetic demo. Keep false in hosted environments.
NEXT_PUBLIC_DEMO_BYPASS_AUTH=false
# Never use service-role/secret keys in NEXT_PUBLIC_ variables.
# Optional canonical browser origin for deployments behind a proxy.
# LAUNCHPAD_APP_ORIGIN=https://your-app.example
# Isolated local integration runners only (never production, loopback hosts only):
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=   # prefer apps/web/.env.s01-integration (Next does not auto-load that file)
# TEST_APP_ORIGIN=http://127.0.0.1:<ephemeral>  # set by scripts/s01-api-integration
#
# Safe bootstrap (refuses non-loopback; noclobber; mode 0600; secret file separate):
#   ./scripts/s01-write-env-local
# PostgREST Auth integration (loads .env.local + .env.s01-integration; requires admin key or exit 2):
#   ./scripts/project npm --prefix apps/web run test:integration
# HTTP cookie API integration (always builds unique dist; secret test-only):
#   ./scripts/s01-api-integration

# --- AI Sales Setter (Instagram API with Instagram Login). Names only; never commit values. ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match a redirect registered in the Meta app, e.g. https://app.yourdomain.com/api/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Random secret for signing the OAuth state (32+ random characters)
SETTER_STATE_SECRET=
# Meta app secret used to check X-Hub-Signature-256 on webhooks (usually the same value as INSTAGRAM_APP_SECRET)
META_APP_SECRET=
# Your own chosen string; type the same value into the Meta webhook setup
META_WEBHOOK_VERIFY_TOKEN=
# 64 hex characters (openssl rand -hex 32): encrypts stored Instagram tokens
SETTER_TOKEN_KEY=
# Random secret for signed click links
SETTER_CLICK_SECRET=
# Graph API version for sends (default v25.0)
META_GRAPH_VERSION=v25.0
# Real Instagram sends happen ONLY when this is 1. Leave unset until App Review, owner opt-in and a live test have passed.
SETTER_LIVE_SEND=

# AI model for the setter (and other AI features). From console.anthropic.com
ANTHROPIC_API_KEY=
# Setter model (default claude-haiku-5-5; claude-sonnet-5-5 writes better but costs about 20x more)
SETTER_MODEL=

# Stripe (test mode keys start sk_test_)
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint /api/webhooks/stripe/setter-credits (starts whsec_)
STRIPE_SETTER_WEBHOOK_SECRET=

# Marketing Engine (ad angles). Default writer: Claude via ANTHROPIC_API_KEY. Set to openai or demo to override.
MARKETING_TEXT_PROVIDER=
MARKETING_TEXT_MODEL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# AI Team (Marketing + Social agents). Every provider falls back to a clearly labelled MOCK when its key is missing.
AGENTS_ENABLED=true
SOCIAL_PUBLISHING_ENABLED=false
PAID_META_ADS_ENABLED=false
AUTO_SEND_MESSAGES_ENABLED=false
APP_PUBLIC_URL=
AGENT_ASSET_SECRET=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE_PORTRAIT=
OPENAI_IMAGE_SIZE_STORY=
OPENAI_IMAGE_SIZE_SQUARE=
CREATOMATE_API_KEY=
CREATOMATE_REEL_TEMPLATE_ID=
CREATOMATE_STATIC_TEMPLATE_ID=
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
