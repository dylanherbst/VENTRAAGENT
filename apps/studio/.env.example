# AiMoneyPrinter Studio: your own private app for your own brands. Names only, never real values here.
# Login (make both with: npm run password)
STUDIO_PASSWORD_HASH=
STUDIO_SESSION_SECRET=
# Where your data lives. Hosted: Supabase (table studio_snapshots). On your Mac without these, a private .studio-data folder is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STUDIO_STORAGE=file
# STUDIO_DATA_DIR=
STUDIO_PUBLIC_URL=
# AI: writing (Claude, already used by the main app), setter model, optional OpenAI.
ANTHROPIC_API_KEY=
MARKETING_TEXT_MODEL=
SETTER_MODEL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Video and publishing (mock until set). Real posting also needs SOCIAL_PUBLISHING_ENABLED=true.
CREATOMATE_API_KEY=
CREATOMATE_REEL_TEMPLATE_ID=
CREATOMATE_STATIC_TEMPLATE_ID=
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
AGENTS_ENABLED=true
SOCIAL_PUBLISHING_ENABLED=false
